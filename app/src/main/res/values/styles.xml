<resources>
    <style name="Theme.BSA" parent="Theme.AppCompat.NoActionBar">
        <item name="android:fontFamily">sans</item><item name="android:windowLightStatusBar">false</item><item name="android:statusBarColor">#090D10</item><item name="android:navigationBarColor">#090D10</item><item name="android:windowBackground">#090D10</item>
    </style>
    <style name="BsaMapButton"><item name="android:layout_width">46dp</item><item name="android:layout_height">46dp</item><item name="android:layout_margin">2dp</item><item name="android:background">@drawable/map_button_bg</item><item name="android:padding">11dp</item><item name="android:scaleType">fitCenter</item></style>
    <style name="BsaCheck"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:textColor">#E8EDF0</item><item name="android:textSize">13sp</item></style>
    <style name="BsaRadio"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:textColor">#E8EDF0</item><item name="android:textSize">12sp</item></style>
    <style name="BsaPanelTitle"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:textColor">#91D6F5</item><item name="android:textSize">12sp</item><item name="android:textStyle">bold</item></style>
    <style name="BsaSmallButton"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:minHeight">38dp</item><item name="android:textSize">11sp</item></style>
</resources>
